POSTGRES_DB=transcendence
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DJANGO_SECRET_KEY=unetestkeypourdevelopper

# A changer pour la version finale
VAULT_DEV_ROOT_TOKEN_ID=root
VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200
VAULT_ADDR=http://vault:8200

VAULT_ROOT_TOKEN=root

OAUTH_42_CLIENT_ID=oauth-42-id
OAUTH_42_CLIENT_SECRET=oauth-42-secret

OAUTH_GOOGLE_CLIENT_ID=oauth-google-id
OAUTH_GOOGLE_CLIENT_SECRET=oauth-google-secret

OAUTH_GITHUB_CLIENT_ID=oauth-github-id
OAUTH_GITHUB_CLIENT_SECRET=oauth-github-secret

TOTP_ENCRYPTION_KEY=cle-de-cryptage-comprenant-32-caracters-min
TOTP_ISSUER_NAME=42-Transcendence

# WAF (ModSecurity + OWASP CRS dans nginx)
# DetectionOnly : log sans bloquer ; On : prevention (bloque en 403)
MODSEC_RULE_ENGINE=On
# Niveau de paranoia CRS 1-4 (2 = protection renforcee, plus de faux positifs)
BLOCKING_PARANOIA=1
ANOMALY_INBOUND=5
