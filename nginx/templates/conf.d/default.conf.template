limit_req_zone $binary_remote_addr zone=general:50m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=6r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server_tokens ${SERVER_TOKENS};
more_set_headers 'Server: ${SERVER_HEADER}';

# Redirect HTTP -> HTTPS
server {
    listen ${PORT} default_server;
    server_name _;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen ${SSL_PORT} ssl;
    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;
    ssl_dhparam /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;
    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 12M;
    limit_req zone=general burst=40 nodelay;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Auth: rate limiting strict (anti brute-force)
    location ^~ /api/auth/ {
        limit_req zone=auth burst=5 nodelay;
        modsecurity_rules '
            SecAction "id:9002000,phase:1,pass,nolog,setvar:tx.blocking_paranoia_level=2"
        ';
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/docs/ {
		modsecurity_rules '
			SecAction "id:9002001,phase:1,pass,nolog,setvar:tx.blocking_paranoia_level=2"
		';
		set $backend_upstream http://backend:8000;
		proxy_pass $backend_upstream;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_hide_header X-Frame-Options;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "same-origin" always;
		add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
	}

    location /api/ {
        modsecurity_rules '
            SecAction "id:9002001,phase:1,pass,nolog,setvar:tx.blocking_paranoia_level=2"
        ';
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        modsecurity_rules '
            SecAction "id:9002002,phase:1,pass,nolog,setvar:tx.blocking_paranoia_level=2,setvar:tx.inbound_anomaly_score_threshold=3"
        ';
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        modsecurity_rules '
            SecAction "id:9002003,phase:1,pass,nolog,setvar:tx.inbound_anomaly_score_threshold=25"
        ';
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location /media/ {
        alias /app/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    location ^~ /media/attachments/ {
        return 404;
    }

    location /protected/ {
        internal;
        alias /app/media/;
        add_header X-Content-Type-Options "nosniff";
    }

    location / {
        set $frontend_upstream http://frontend:4200;
        proxy_pass $frontend_upstream;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
